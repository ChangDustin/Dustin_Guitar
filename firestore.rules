rules_version = '2';

// 小齊吉他 Dustin Guitar：學員資料只有本人讀寫得到。
// 欄位與上限跟 assets/js/account/progress.js、firebase.js 寫入的內容一致；
// CLAUDE.md 第 6 節：不要放寬這份規則。
// 使用方式：Firebase 主控台 → Firestore Database → 規則 → 整份貼上 → 發布。
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // 學員基本資料：users/{uid}
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'createdAt', 'lastLogin'])
        && (!('name' in request.resource.data)
            || (request.resource.data.name is string && request.resource.data.name.size() <= 100));

      // 每首歌的個人進度：users/{uid}/songs/{歌曲 id}
      match /songs/{songId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && songId.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
          && request.resource.data.keys().hasOnly(['status', 'note', 'fav', 'updatedAt'])
          && request.resource.data.status in ['', '想學', '練習中', '已學會']
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 4000
          && request.resource.data.fav is bool
          && request.resource.data.updatedAt == request.time;
      }

      // 練習日誌：users/{uid}/logs/{自動 id}；只能新增與刪除，不能改
      match /logs/{logId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['date', 'minutes', 'songIds', 'note', 'createdAt'])
          && request.resource.data.date is string
          && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.minutes is int
          && request.resource.data.minutes >= 1
          && request.resource.data.minutes <= 1440
          && request.resource.data.songIds is list
          && request.resource.data.songIds.size() <= 20
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 1000
          && request.resource.data.createdAt == request.time;
      }
    }
  }
}
